# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# LMStudio model identifier (must match exactly what LMStudio shows)
LMSTUDIO_MODEL=qwen/qwen3.5-9b

# Display timezone for the Streamlit panel (IANA timezone name)
# Examples: Europe/Madrid, America/New_York, America/Mexico_City, UTC
DISPLAY_TIMEZONE=Europe/Madrid
